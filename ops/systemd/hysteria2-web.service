[Unit]
Description=Hysteria 2 Control Plane Web
After=network-online.target hysteria2-api.service
Wants=network-online.target

[Service]
Type=simple
User=hysteria2
Group=hysteria2
WorkingDirectory=/opt/hysteria2-control-plane/current/apps/web
EnvironmentFile=/opt/hysteria2-control-plane/shared/web.env
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start --hostname 0.0.0.0 --port 3001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
