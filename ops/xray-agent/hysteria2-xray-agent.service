[Unit]
Description=Hysteria2 Control Plane Xray Agent
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/hysteria2-xray-agent.env
ExecStart=/usr/local/bin/hysteria2-xray-agent
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
