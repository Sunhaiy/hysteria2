XRAY_AGENT_SECRET=replace-with-a-long-random-secret
XRAY_AGENT_LISTEN=127.0.0.1:9010
XRAY_API_ADDRESS=127.0.0.1:10085
XRAY_INBOUND_TAG=vless-reality
XRAY_AGENT_STATE_FILE=/var/lib/hysteria2-xray-agent/traffic-batch.json
# Only these logical names can be requested over HTTP. Values are fixed here,
# never supplied by the control-plane request.
XRAY_AGENT_CONTROL_SERVICES=xray=xray.service,hysteria2=hysteria-server.service
