generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  PAUSED
  CANCELED
}

enum TrafficPackStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  APPLIED
  VOID
}

enum OrderKind {
  RENEWAL
  TRAFFIC_PACK
  MANUAL_CREDIT
}

enum RedemptionCodeKind {
  PLAN
  TRAFFIC_PACK
  BALANCE
  DISCOUNT
}

enum WalletTxnKind {
  TOPUP
  PURCHASE
  REFUND
  ADJUST
}

enum RedemptionCodeStatus {
  ACTIVE
  REDEEMED
  VOID
  EXPIRED
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  displayName     String
  passwordHash    String
  plainPassword   String?
  role            UserRole         @default(MEMBER)
  status          UserStatus       @default(ACTIVE)
  notes           String?
  balanceCents    Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  accessTokens    AccessToken[]
  subscriptions   Subscription[]
  trafficPacks    TrafficPack[]
  manualOrders    ManualOrder[]    @relation("ManualOrderTargetUser")
  processedOrders ManualOrder[]    @relation("ManualOrderProcessedBy")
  createdCodes    RedemptionCode[] @relation("RedemptionCodeCreatedBy")
  redeemedCodes   RedemptionCode[] @relation("RedemptionCodeRedeemedBy")
  redemptionUses  RedemptionUse[]
  walletTxns      WalletTransaction[]
  authEvents      AuthEvent[]
  usageRollups    UsageRollup[]
  onlineSnapshots OnlineSnapshot[]
}

model AccessToken {
  id         String      @id @default(cuid())
  userId     String
  label      String
  token      String      @unique
  createdAt  DateTime    @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  authEvents AuthEvent[]
}

model Plan {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String?
  active          Boolean          @default(true)
  trafficBytes    BigInt
  durationDays    Int
  speedUpMbps     Int
  speedDownMbps   Int
  deviceLimit     Int
  priceCents      Int
  accent          String           @default("green")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  subscriptions   Subscription[]
  bindings        PlanBinding[]
  manualOrders    ManualOrder[]
  redemptionCodes RedemptionCode[]
}

model Node {
  id                String           @id @default(cuid())
  label             String           @unique
  hostname          String
  port              Int
  obfsPassword      String?
  sni               String?
  pinSHA256         String?
  allowInsecureTls  Boolean          @default(false)
  trafficApiBaseUrl String
  trafficApiSecret  String
  active            Boolean          @default(true)
  speedUpMbps       Int
  speedDownMbps     Int
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  planBindings      PlanBinding[]
  subscriptions     Subscription[]
  authEvents        AuthEvent[]
  usageRollups      UsageRollup[]
  onlineSnapshots   OnlineSnapshot[]

  @@unique([hostname, port])
}

model PlanBinding {
  id        String   @id @default(cuid())
  planId    String
  nodeId    String
  priority  Int      @default(0)
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([planId, nodeId])
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  planId                String
  nodeId                String
  status                SubscriptionStatus @default(ACTIVE)
  startsAt              DateTime
  endsAt                DateTime
  includedTrafficBytes  BigInt
  bonusTrafficBytes     BigInt             @default(0)
  consumedTrafficBytes  BigInt             @default(0)
  speedUpMbpsSnapshot   Int
  speedDownMbpsSnapshot Int
  deviceLimitSnapshot   Int
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  node                  Node               @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  trafficPacks          TrafficPack[]
  usageRollups          UsageRollup[]
}

model TrafficPack {
  id             String            @id @default(cuid())
  userId         String
  subscriptionId String
  label          String
  totalBytes     BigInt
  remainingBytes BigInt
  status         TrafficPackStatus @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model ManualOrder {
  id            String      @id @default(cuid())
  userId        String
  processedById String?
  planId        String?
  status        OrderStatus @default(PENDING)
  kind          OrderKind
  amountCents   Int
  durationDays  Int?
  trafficBytes  BigInt?
  note          String?
  createdAt     DateTime    @default(now())
  processedAt   DateTime?
  user          User        @relation("ManualOrderTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  processedBy   User?       @relation("ManualOrderProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  plan          Plan?       @relation(fields: [planId], references: [id], onDelete: SetNull)
}

model RedemptionCode {
  id              String               @id @default(cuid())
  code            String               @unique
  label           String
  kind            RedemptionCodeKind
  status          RedemptionCodeStatus @default(ACTIVE)
  planId          String?
  trafficBytes    BigInt?
  amountCents     Int                  @default(0)
  discountPercent Int?
  discountCents   Int?
  maxUses         Int                  @default(1)
  usedCount       Int                  @default(0)
  note            String?
  expiresAt       DateTime?
  createdById     String?
  redeemedById    String?
  redeemedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  plan            Plan?                @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdBy       User?                @relation("RedemptionCodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  redeemedBy      User?                @relation("RedemptionCodeRedeemedBy", fields: [redeemedById], references: [id], onDelete: SetNull)
  uses            RedemptionUse[]

  @@index([status, createdAt])
}

model RedemptionUse {
  id         String         @id @default(cuid())
  codeId     String
  userId     String
  orderId    String?
  redeemedAt DateTime       @default(now())
  code       RedemptionCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([codeId, userId])
  @@index([codeId, redeemedAt])
}

model WalletTransaction {
  id          String        @id @default(cuid())
  userId      String
  amountCents Int
  kind        WalletTxnKind
  note        String?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuthEvent {
  id                    String       @id @default(cuid())
  userId                String?
  accessTokenId         String?
  nodeId                String?
  granted               Boolean
  reason                String
  remoteAddr            String?
  requestedTxBps        Int?
  submittedTokenPreview String?
  createdAt             DateTime     @default(now())
  user                  User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessToken           AccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)
  node                  Node?        @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([reason, submittedTokenPreview, remoteAddr, createdAt])
}

model UsageRollup {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String
  nodeId         String
  bucketStart    DateTime
  txBytes        BigInt
  rxBytes        BigInt
  source         String
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  node           Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([userId, bucketStart])
}

model OnlineSnapshot {
  id                String   @id @default(cuid())
  userId            String
  nodeId            String
  concurrentClients Int
  capturedAt        DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  node              Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([userId, capturedAt])
  @@index([nodeId, capturedAt])
}

// Simple key-value store for admin-editable runtime settings (SMTP, feature
// toggles like open registration). Secret values are masked when read back.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
